# BeatIQ mode defaults
VITE_DEFAULT_MODE=demo

# Optional live traffic provider (TomTom)
# NOTE: Vite env vars are exposed to the browser bundle.
# For production, route provider calls through a secure backend proxy.
VITE_TOMTOM_API_KEY=

# Optional live weather provider (OpenWeather)
# NOTE: Vite env vars are exposed to the browser bundle.
# For production, route provider calls through a secure backend proxy.
VITE_OPENWEATHER_API_KEY=
